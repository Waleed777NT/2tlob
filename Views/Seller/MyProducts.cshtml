@model IEnumerable<_2tlob.Models.Product>

@{
    ViewData["Title"] = "My Products";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>My Products</h2>
        <a asp-action="CreateProduct" class="btn btn-primary">+ Add New Product</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No products added yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(item.ImageUrl ?? "/images/products/default.jpg")" alt="@item.Name" style="width: 50px; height: 50px; object-fit: cover;" class="rounded" />
                            </td>
                            <td>@item.Name</td>
                            <td>@(item.Category?.Name ?? "N/A")</td>
                            <td>$@item.Price.ToString("N2")</td>
                            <td>
                                <form asp-action="UpdateQuantity" method="post" class="d-inline-flex align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.Id" />
                                    <input type="number" name="quantity" value="@item.AvailableQuantity" min="0" class="form-control form-control-sm me-1" style="width: 80px;" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Save</button>
                                </form>
                            </td>
                            <td>
                                <a asp-action="EditProduct" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <form asp-action="DeleteProduct" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>