@model _2tlob.ViewModels.Seller.SellerDashboardViewModel

@{
    ViewData["Title"] = "Seller Dashboard";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Seller Dashboard</h2>
        <div>
            <a asp-action="MyProducts" class="btn btn-outline-primary me-2">Manage Products</a>
            <a asp-action="MyOrders" class="btn btn-outline-secondary">Manage Orders</a>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: #e8f1ff; flex-shrink: 0;">
                        <i class="bi bi-box-seam fs-4 text-primary"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark">@Model.TotalProducts</h4>
                        <span class="text-muted small">Total Products</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: #fff3cd; flex-shrink: 0;">
                        <i class="bi bi-exclamation-triangle fs-4 text-warning"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark">@Model.LowStockProducts</h4>
                        <span class="text-muted small">Low Stock Alert</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: #d1e7dd; flex-shrink: 0;">
                        <i class="bi bi-cart-check fs-4 text-success"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark">@Model.TotalOrdersCount</h4>
                        <span class="text-muted small">Total Orders</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: #e0f7fa; flex-shrink: 0;">
                        <i class="bi bi-currency-dollar fs-4 text-info"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark">$@Model.TotalSalesRevenue.ToString("N2")</h4>
                        <span class="text-muted small">Total Revenue</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 rounded-4 bg-white">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background-color: #fff0d6; flex-shrink: 0;">
                        <i class="bi bi-star-fill fs-4 text-warning"></i>
                    </div>
                    <div>
                        @if (Model.SellerReviewCount > 0)
                        {
                            <h4 class="fw-bold mb-0 text-dark">@Model.SellerAverageRating.ToString("0.0") <small class="text-muted" style="font-size: .75rem;">/ 5</small></h4>
                            <span class="text-muted small">Seller Rating (@Model.SellerReviewCount review@(Model.SellerReviewCount == 1 ? "" : "s"))</span>
                        }
                        else
                        {
                            <h4 class="fw-bold mb-0 text-dark">&mdash;</h4>
                            <span class="text-muted small">No ratings yet</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>