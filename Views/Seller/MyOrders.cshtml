@using _2tlob.Enum
@model _2tlob.ViewModels.Order.SellerOrderListViewModel
@{
    ViewData["Title"] = "My Orders";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth-theme.css" asp-append-version="true" />
}

<div class="tlob-scope">
    <div class="tlob-page-head">
        <p class="tlob-eyebrow">Seller</p>
        <h1>Customer orders</h1>
        <p>Orders that include at least one of your products. Total sales: <strong>@Model.TotalSellerSales.ToString("C")</strong></p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="tlob-callout tlob-callout--gold mb-3"><i class="bi bi-check-circle mt-1"></i><span>@TempData["SuccessMessage"]</span></div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="tlob-callout tlob-callout--brick mb-3"><i class="bi bi-exclamation-triangle-fill mt-1"></i><span>@TempData["ErrorMessage"]</span></div>
    }

    @if (!Model.Orders.Any())
    {
        <div class="tlob-card tlob-empty">
            <i class="bi bi-receipt" style="font-size: 2.5rem; color: var(--line);"></i>
            <h4>No orders yet</h4>
            <p class="mb-0">Once a customer orders one of your products, it'll show up here.</p>
        </div>
    }
    else
    {
        <div class="tlob-card tlob-panel">
            <div class="tlob-table-wrap">
                <table class="tlob-table">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Items</th>
                            <th>Total (your share)</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            var pillClass = order.OrderStatus switch
                            {
                                OrderStatus.Pending => "tlob-pill--gold",
                                OrderStatus.Confirmed => "tlob-pill--green",
                                OrderStatus.Shipped => "tlob-pill--green",
                                OrderStatus.Delivered => "tlob-pill--green",
                                OrderStatus.Cancelled => "tlob-pill--brick",
                                _ => "tlob-pill--muted"
                            };

                            <tr>
                                <td class="fw-bold" style="color: var(--green-700);">#@order.OrderId</td>
                                <td class="small text-muted">@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                <td class="small">@order.CustomerName</td>
                                <td class="small">@order.ItemCount item(s)</td>
                                <td class="fw-bold">@order.TotalAmount.ToString("C")</td>
                                <td><span class="tlob-pill @pillClass">@order.OrderStatus</span></td>
                                <td class="text-end">
                                    <a asp-controller="Seller" asp-action="OrderDetails" asp-route-id="@order.OrderId" class="tlob-btn tlob-btn--ghost tlob-btn-sm">
                                        <i class="bi bi-eye me-1"></i>View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
