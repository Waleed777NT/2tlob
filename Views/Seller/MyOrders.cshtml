@model _2tlob.ViewModels.Order.SellerOrderListViewModel
@using _2tlob.Enum

@{
    ViewData["Title"] = "Seller Orders";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }
        <h2>Customer Orders for Your Products</h2>
        <h5 class="text-muted">Total Sales: $@Model.TotalSellerSales.ToString("N2")</h5>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-info">No orders found for your products yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Product</th>
                        <th>Customer</th>
                        <th>Qty</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>#@item.OrderId</td>
                            <td>@item.OrderDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="@(string.IsNullOrEmpty(item.ProductImageUrl) ? "/images/products/default.jpg" : item.ProductImageUrl)" style="width: 40px; height: 40px; object-fit: cover;" class="rounded me-2" />
                                    <span>@item.ProductName</span>
                                </div>
                            </td>
                            <td>
                                <div>@item.CustomerName</div>
                                <small class="text-muted">@item.PhoneNumber</small>
                            </td>
                            <td>@item.Quantity</td>
                            <td>$@item.LineTotal.ToString("N2")</td>
                            <td>
                                <span class="badge @(item.OrderStatus == OrderStatus.Delivered ? "bg-success" : item.OrderStatus == OrderStatus.Cancelled ? "bg-danger" : "bg-warning text-dark")">
                                    @item.OrderStatus
                                </span>
                            </td>
                            <td>
                                @if (item.OrderStatus != OrderStatus.Delivered && item.OrderStatus != OrderStatus.Cancelled)
                                {
                                    <form asp-action="UpdateOrderStatus" method="post" class="d-flex gap-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@item.OrderId" />
                                        <select name="status" class="form-select form-select-sm" style="width: 130px;">
                                            @foreach (OrderStatus status in System.Enum.GetValues(typeof(OrderStatus)))
                                            {
                                                <option value="@status" selected="@(status == item.OrderStatus)">@status</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-primary">Update</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">Completed</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>