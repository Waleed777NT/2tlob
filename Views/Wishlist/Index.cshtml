@model List<_2tlob.Models.Product>
@{
    ViewData["Title"] = "My Wishlist";
}

@Html.AntiForgeryToken()

@section Styles {
    <link rel="stylesheet" href="~/css/auth-theme.css" asp-append-version="true" />
}

<div class="tlob-scope">
    <div class="tlob-page-head">
        <p class="tlob-eyebrow">My account</p>
        <h1>My wishlist</h1>
        <p>Products you've saved for later.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="tlob-card tlob-empty">
            <i class="bi bi-heart" style="font-size: 2.5rem; color: var(--line);"></i>
            <h4>Your wishlist is empty</h4>
            <p class="mb-3">Tap the heart icon on any product to save it here.</p>
            <a asp-controller="Products" asp-action="Index" class="tlob-btn" style="width: auto; padding-inline: 1.6rem;">
                <i class="bi bi-grid me-1"></i>Browse products
            </a>
        </div>
    }
    else
    {
        <div class="row g-4" id="wishlist-grid">
            @foreach (var product in Model)
            {
                var partialViewData = new ViewDataDictionary(ViewData)
                {
                    { "IsWishlisted", true }
                };
                @await Html.PartialAsync("_ProductCard", product, partialViewData)
            }
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/product-actions.js" asp-append-version="true"></script>
    <script>
        // On this page specifically, un-hearting a product should drop its card
        // straight away instead of just flipping the icon (product-actions.js
        // already handles the actual toggle call + icon swap for us).
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('#wishlist-grid .js-toggle-wishlist').forEach(btn => {
                const icon = btn.querySelector('.js-wishlist-icon');
                if (!icon) return;

                new MutationObserver(() => {
                    if (!icon.classList.contains('bi-heart-fill')) {
                        const card = btn.closest('.col-md-3, .col-sm-6');
                        if (card) {
                            card.style.transition = 'opacity .25s ease';
                            card.style.opacity = '0';
                            setTimeout(() => card.remove(), 250);
                        }
                    }
                }).observe(icon, { attributes: true, attributeFilter: ['class'] });
            });
        });
    </script>
}
