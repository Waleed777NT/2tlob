@using _2tlob.ViewModels.Account
@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth-theme.css" asp-append-version="true" />
}

<div class="tlob-scope">
    <div class="tlob-auth">
        <aside class="tlob-auth__brand">
            <div class="tlob-auth__mark">2tlob</div>
            <div class="tlob-auth__brand-mid">
                <h1>Every stall,<br />one counter.</h1>
                <p>Sign in to track orders, manage your storefront, or pick up a wishlist you started earlier.</p>
            </div>
            <div class="tlob-scallop" aria-hidden="true"></div>
        </aside>

        <section class="tlob-auth__form">
            <div class="tlob-auth__form-inner">
                <p class="tlob-eyebrow">Account</p>
                <h2>Welcome back</h2>
                <p class="tlob-auth__sub">Sign in with the email you registered with.</p>

                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="tlob-form__summary"></div>

                    <div class="tlob-field">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" placeholder="name@example.com" autofocus autocomplete="username" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="tlob-field">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" placeholder="••••••••" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <label class="tlob-check">
                        <input asp-for="RememberMe" />
                        <span asp-for="RememberMe">Keep me signed in</span>
                    </label>

                    <button type="submit" class="tlob-btn">Sign in</button>

                    <p class="tlob-auth__switch">
                        New to 2tlob?
                        <a asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]">Create an account</a>
                    </p>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
