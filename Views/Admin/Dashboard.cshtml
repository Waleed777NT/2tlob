@using _2tlob.ViewModels.Admin
@using _2tlob.Enum
@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    .stat-icon {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
    }

    .stat-card {
        transition: transform .15s ease;
    }

        .stat-card:hover {
            transform: translateY(-2px);
        }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-primary me-2"></i>Admin Dashboard</h2>
        <p class="text-muted mb-0">A quick look at how 2tlob is doing today.</p>
    </div>
    <div class="btn-group">
        <a asp-controller="Admin" asp-action="Users" class="btn btn-outline-secondary"><i class="bi bi-people me-1"></i>Users</a>
        <a asp-controller="Admin" asp-action="SellerRequests" class="btn btn-outline-secondary"><i class="bi bi-shop me-1"></i>Seller Requests</a>
        @* <a asp-controller="Admin" asp-action="ContactMessages" class="btn btn-outline-secondary"><i class="bi bi-envelope me-1"></i>Messages</a> *@
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center">
                    <i class="bi bi-people fs-5"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@Model.TotalCustomers</div>
                    <div class="text-muted small">Customers</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon rounded-circle bg-info bg-opacity-10 text-info d-flex align-items-center justify-content-center">
                    <i class="bi bi-shop fs-5"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@Model.TotalSellers</div>
                    <div class="text-muted small">Sellers</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon rounded-circle bg-secondary bg-opacity-10 text-secondary d-flex align-items-center justify-content-center">
                    <i class="bi bi-box-seam fs-5"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@Model.TotalProducts</div>
                    <div class="text-muted small">Products</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center">
                    <i class="bi bi-receipt fs-5"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@Model.TotalOrders</div>
                    <div class="text-muted small">Total Orders</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon rounded-circle bg-warning bg-opacity-25 text-warning-emphasis d-flex align-items-center justify-content-center">
                    <i class="bi bi-hourglass-split fs-5"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@Model.PendingOrders</div>
                    <div class="text-muted small">Pending Orders</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon rounded-circle bg-danger bg-opacity-10 text-danger d-flex align-items-center justify-content-center">
                    <i class="bi bi-person-plus fs-5"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@Model.PendingSellerRequests</div>
                    <div class="text-muted small">Pending Seller Requests</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-3">
        <div class="card stat-card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center">
                    <i class="bi bi-cash-stack fs-5"></i>
                </div>
                <div>
                    <div class="fs-4 fw-bold">@Model.TotalRevenue.ToString("C")</div>
                    <div class="text-muted small">Total Revenue</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="bi bi-receipt-cutoff me-1 text-primary"></i>Recent Orders</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentOrders.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No orders yet.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td>#@order.Id</td>
                                    <td>@order.Customer?.FullName</td>
                                    <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td>@order.TotalAmount.ToString("C")</td>
                                    <td>
                                        <span class="badge bg-@(order.Status switch
                                              {
                                                  OrderStatus.Pending => "warning text-dark",
                                                  OrderStatus.Confirmed => "info text-dark",
                                                  OrderStatus.Shipped => "primary",
                                                  OrderStatus.Delivered => "success",
                                                  OrderStatus.Cancelled => "danger",
                                                  _ => "secondary"
                                              })">@order.Status</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="bi bi-person-plus me-1 text-primary"></i>Recent Seller Requests</h6>
                <a asp-controller="Admin" asp-action="SellerRequests" class="small">View all</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Applicant</th>
                            <th>Business</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentSellerRequests.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">No requests yet.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var request in Model.RecentSellerRequests)
                            {
                                <tr>
                                    <td>
                                        @request.User?.FullName
                                        <div class="text-muted small">@request.User?.Email</div>
                                    </td>
                                    <td>@request.BusinessName</td>
                                    <td>
                                        <span class="badge bg-@(request.Status switch
                                              {
                                                  RequestStatus.Pending => "warning text-dark",
                                                  RequestStatus.Approved => "success",
                                                  RequestStatus.Rejected => "danger",
                                                  _ => "secondary"
                                              })">@request.Status</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
