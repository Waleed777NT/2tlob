@using _2tlob.Enum
@using _2tlob.Models
@model IEnumerable<ContactMessage>
@{
    ViewData["Title"] = "Contact Messages";
    var messages = Model.ToList();
    var selectedStatus = ViewBag.SelectedStatus as ContactMessageStatus?;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-envelope text-primary me-2"></i>Contact Messages</h2>
        <p class="text-muted mb-0">@messages.Count(m => m.Status == ContactMessageStatus.New) new message(s) awaiting a reply.</p>
    </div>
    <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
    </a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="ContactMessages" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Status</label>
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">All statuses</option>
                    <option value="@ContactMessageStatus.New" selected="@(selectedStatus == ContactMessageStatus.New ? "selected" : null)">New</option>
                    <option value="@ContactMessageStatus.InProgress" selected="@(selectedStatus == ContactMessageStatus.InProgress ? "selected" : null)">In Progress</option>
                    <option value="@ContactMessageStatus.Resolved" selected="@(selectedStatus == ContactMessageStatus.Resolved ? "selected" : null)">Resolved</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>From</th>
                    <th>Subject</th>
                    <th>Reason</th>
                    <th>Received</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!messages.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No messages found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var message in messages)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@message.Name</div>
                                <div class="text-muted small">@message.Email</div>
                            </td>
                            <td>
                                <a href="#" data-bs-toggle="modal" data-bs-target="#messageModal-@message.Id" class="text-decoration-none">
                                    @message.Subject
                                </a>
                            </td>
                            <td><span class="badge bg-light text-dark border">@message.Reason</span></td>
                            <td>@message.CreatedAt.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="badge bg-@(message.Status switch
                                      {
                                          ContactMessageStatus.New => "primary",
                                          ContactMessageStatus.InProgress => "warning text-dark",
                                          ContactMessageStatus.Resolved => "success",
                                          _ => "secondary"
                                      })">@message.Status</span>
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#messageModal-@message.Id">
                                    <i class="bi bi-eye"></i> View
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@foreach (var message in messages)
{
    <div class="modal fade" id="messageModal-@message.Id" tabindex="-1" aria-labelledby="messageModalLabel-@message.Id" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="messageModalLabel-@message.Id">@message.Subject</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex justify-content-between flex-wrap mb-3">
                        <div>
                            <div class="fw-semibold">@message.Name</div>
                            <div class="text-muted small">@message.Email</div>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-light text-dark border mb-1">@message.Reason</span>
                            <div class="text-muted small">@message.CreatedAt.ToString("MMM dd, yyyy - h:mm tt")</div>
                        </div>
                    </div>
                    <p style="white-space: pre-wrap;">@message.Message</p>

                    @if (message.Status == ContactMessageStatus.Resolved)
                    {
                        <div class="alert alert-success mt-3 mb-0">
                            <div class="fw-semibold"><i class="bi bi-check-circle me-1"></i>Resolved @(message.ResolvedAt.HasValue ? "on " + message.ResolvedAt.Value.ToString("MMM dd, yyyy") : "")</div>
                            @if (!string.IsNullOrWhiteSpace(message.AdminNotes))
                            {
                                <div class="small mt-1">@message.AdminNotes</div>
                            }
                        </div>
                    }
                    else
                    {
                        <hr />
                        <form asp-action="ResolveContactMessage" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@message.Id" />
                            <label class="form-label small text-muted">Resolution note (optional)</label>
                            <textarea name="adminNotes" class="form-control mb-3" rows="3" placeholder="How was this resolved?">@message.AdminNotes</textarea>
                            <div class="d-flex justify-content-end gap-2">
                                @if (message.Status == ContactMessageStatus.New)
                                {
                                    <button type="submit" formaction="@Url.Action("MarkContactMessageInProgress")" class="btn btn-outline-warning">
                                        <i class="bi bi-hourglass-split me-1"></i>Mark In Progress
                                    </button>
                                }
                                <button type="submit" formaction="@Url.Action("ResolveContactMessage")" class="btn btn-success">
                                    <i class="bi bi-check-circle me-1"></i>Mark Resolved
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
}
