@using _2tlob.Enum
@model IEnumerable<Order>
@{
    ViewData["Title"] = "All Orders";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth-theme.css" asp-append-version="true" />
}

<div class="tlob-scope">
    <div class="tlob-page-head">
        <p class="tlob-eyebrow">Admin</p>
        <h1>Platform orders</h1>
        <p>System-wide customer orders, status tracking, and order fulfillment.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="tlob-card tlob-empty">
            <i class="bi bi-receipt" style="font-size: 2.5rem; color: var(--line);"></i>
            <h4>No orders yet</h4>
            <p class="mb-0">Orders placed across the platform will show up here.</p>
        </div>
    }
    else
    {
        <div class="tlob-card tlob-panel">
            <div class="tlob-table-wrap">
                <table class="tlob-table">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Items</th>
                            <th>Total amount</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            var pillClass = order.Status switch
                            {
                                OrderStatus.Pending => "tlob-pill--gold",
                                OrderStatus.Confirmed => "tlob-pill--green",
                                OrderStatus.Shipped => "tlob-pill--green",
                                OrderStatus.Delivered => "tlob-pill--green",
                                OrderStatus.Cancelled => "tlob-pill--brick",
                                _ => "tlob-pill--muted"
                            };

                            <tr>
                                <td class="fw-bold" style="color: var(--green-700);">#@order.Id</td>
                                <td class="small text-muted">@order.OrderDate.ToString("MMM dd, yyyy HH:mm")</td>
                                <td>
                                    <div class="fw-semibold small">@order.Customer.FullName</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@order.Customer.Email</div>
                                </td>
                                <td class="small">@order.Items.Sum(i => i.Quantity) items</td>
                                <td class="fw-bold text-dark">$@order.TotalAmount.ToString("N2")</td>
                                <td><span class="tlob-pill @pillClass">@order.Status</span></td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@order.Id" class="tlob-btn tlob-btn--ghost tlob-btn-sm">
                                        <i class="bi bi-eye me-1"></i>Manage
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
