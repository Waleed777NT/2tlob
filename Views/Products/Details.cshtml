@model _2tlob.ViewModels.Product.ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Product.Name;
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth-theme.css" asp-append-version="true" />
}

<div class="tlob-scope">
    <div class="tlob-card tlob-panel">
        <div class="row g-4">
            <div class="col-md-5">
                <img src="@Model.Product.ImageUrl" class="img-fluid rounded" alt="@Model.Product.Name" />
                @if (!Model.IsOwner)
                {
                    @Html.AntiForgeryToken()

                    <div class="d-flex gap-2 mt-3">
                        <button type="button" class="btn btn-primary-custom w-100 js-add-to-cart"
                                data-product-id="@Model.Product.Id"
                            @(Model.Product.AvailableQuantity <= 0 ? "disabled" : "")
                                style="min-height: 48px;">
                            <i class="bi bi-cart-plus me-1"></i>Add to Cart
                        </button>

                        <button type="button" class="btn @(Model.IsInWishlist ? "btn-outline-danger" : "btn-outline-secondary") w-100 js-toggle-wishlist"
                                data-product-id="@Model.Product.Id"
                                style="min-height: 48px;">
                            <i class="bi @(Model.IsInWishlist ? "bi-heart-fill" : "bi-heart") me-1 js-wishlist-icon"></i>
                            <span class="js-wishlist-label">@(Model.IsInWishlist ? "Remove from Wishlist" : "Add to Wishlist")</span>
                        </button>
                    </div>
                }
                else
                {
                    <span class="tlob-pill tlob-pill--muted mt-3 d-inline-block">This is your own listing</span>
                }
            </div>
            <div class="col-md-7">
                <p class="tlob-eyebrow mb-1">
                    <a asp-controller="Categories" asp-action="Details" asp-route-id="@Model.Product.CategoryId" class="text-decoration-none">
                        @Model.Product.Category?.Name
                    </a>
                </p>
                <h1 class="mb-1">@Model.Product.Name</h1>
                <p class="text-muted small">Sold by @Model.Product.Seller?.UserName</p>

                <div class="mb-2">
                    <span class="text-warning">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <text>@(i <= Math.Round(Model.AverageRating) ? "★" : "☆")</text>
                        }
                    </span>
                    <span class="text-muted small">(@Model.AverageRating / 5 &middot; @Model.ReviewCount reviews)</span>
                </div>

                <h3 class="text-primary mb-2">@Model.Product.Price.ToString("C")</h3>

                @if (Model.Product.AvailableQuantity <= 0)
                {
                    <span class="tlob-pill tlob-pill--brick">Out of stock</span>
                }
                else
                {
                    <span class="tlob-pill tlob-pill--green">In stock: @Model.Product.AvailableQuantity</span>
                }

                <p class="mt-3">@Model.Product.Description</p>
            </div>
        </div>
    </div>

    <partial name="_ProductReviews" model="Model" />
</div>

@section Scripts {
    <script src="~/js/product-actions.js" asp-append-version="true"></script>
}