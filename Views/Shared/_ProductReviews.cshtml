@model _2tlob.ViewModels.Product.ProductDetailsViewModel

<div class="mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1">Customer Reviews</h4>
            <div class="d-flex align-items-center">
                <span class="text-warning me-2">★</span>
                <span class="fw-bold me-2">@Model.AverageRating.ToString("0.0")</span>
                <span class="text-muted">(@Model.ReviewCount reviews)</span>
            </div>
        </div>

        @if (Model.CanReview)
        {
            <a asp-controller="Reviews" asp-action="AddReview" asp-route-productId="@Model.Product.Id" class="btn btn-outline-primary">
                @(Model.HasReviewed ? "Edit Your Review" : "Write a Review")
            </a>
        }
    </div>

    @if (!Model.Reviews.Any())
    {
        <div class="alert alert-light border">No reviews yet for this product.</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var review in Model.Reviews)
            {
                <div class="list-group-item list-group-item-action flex-column align-items-start py-3">
                    <div class="d-flex w-100 justify-content-between">
                        <h6 class="mb-1 fw-bold">@(review.Customer?.UserName ?? "Verified Customer")</h6>
                        <small class="text-muted">@review.CreatedAt.ToString("MMM dd, yyyy")</small>
                    </div>
                    <div class="text-warning mb-2">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span>@(i <= review.Rating ? "★" : "☆")</span>
                        }
                    </div>
                    <p class="mb-1">@review.Comment</p>
                </div>
            }
        </div>
    }
</div>