@{
    ViewData["Title"] = "404 - Page Not Found";
}

<div class="text-center py-5">
    <div class="display-1 fw-bold mb-3" style="color: #1a3c34;">404</div>
    <h1 class="h3 fw-bold text-dark mb-3">Resource or Page Not Found</h1>
    <p class="text-muted mb-4">The product, page, or record you are searching for does not exist or has been relocated.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom px-4 py-2">
        <i class="bi bi-house me-2"></i>Back to Home
    </a>
</div>
