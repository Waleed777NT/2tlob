@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <div class="display-1 text-danger mb-3"><i class="bi bi-exclamation-octagon"></i></div>
    <h1 class="h3 fw-bold text-dark mb-3">Something went wrong</h1>
    <p class="text-muted mb-4">An unexpected error occurred while processing your request. Our system has logged the event safely.</p>
    
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted mb-4">
            Request Reference ID: <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary-custom px-4 py-2">
        <i class="bi bi-house me-2"></i>Return to Homepage
    </a>
</div>
